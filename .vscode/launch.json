{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Marinara Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/marinara/app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1",
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
